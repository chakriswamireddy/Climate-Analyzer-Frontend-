# Copy to .env and adjust. Never commit real values.
# Full variable reference: docs/02-system-architecture-and-api-contracts.md §15

# --- Backend ---
# Host-side dev (docker compose sets its own values for the api service):
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=climate_analyzer
ADMIN_API_TOKEN=dev-admin-token-change-me
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=json
